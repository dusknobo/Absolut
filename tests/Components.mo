    Real r_energy=dut.port_v.m_flow*actualStream(dut.port_v.h_outflow) + dut.port_l_b.m_flow*actualStream(dut.port_l_b.h_outflow) + dut.port_l_a.m_flow*actualStream(dut.port_l_a.h_outflow) + dut.port_a_ext.m_flow*actualStream(dut.port_a_ext.h_outflow) + dut.port_b_ext.m_flow*actualStream(dut.port_b_ext.h_outflow);
    Real r_externalMass=dut.port_a_ext.m_flow + dut.port_b_ext.m_flow;


  equation
    connect(dut.port_l_b, outlet.ports[1]);
    inlet.m_flow_in=(if time<5 then 0.005 else 0.004); inlet.T_in=365;
    connect(inlet.ports[1], dut.port_l_a);
    connect(steam.port,dut.port_v);
    externalSource.m_flow_in=0.2; externalSource.T_in=(if time<5 then 360 else 358);
    connect(externalSource.ports[1], dut.port_a_ext);
    connect(dut.port_b_ext, externalOutlet.ports[1]);

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end Resorption_AbsorberStatic_wHT_UAfix_Resorption_ext;

