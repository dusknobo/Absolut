    der(integratedMass)=dut.port_l_a.m_flow + dut.port_l_b.m_flow + dut.port_v.m_flow + dut.port_v_a.m_flow;
    der(integratedEnergy)=dut.port_l_a.m_flow*actualStream(dut.port_l_a.h_outflow) + dut.port_l_b.m_flow*actualStream(dut.port_l_b.h_outflow) + dut.port_v.m_flow*actualStream(dut.port_v.h_outflow) + dut.port_v_a.m_flow*actualStream(dut.port_v_a.h_outflow)+(dut.port_a_ext.m_flow*actualStream(dut.port_a_ext.h_outflow) + dut.port_b_ext.m_flow*actualStream(dut.port_b_ext.h_outflow));
    der(integratedSalt)=dut.port_l_a.m_flow*(1-actualStream(dut.port_l_a.Xi_outflow[1])) + dut.port_l_b.m_flow*(1-actualStream(dut.port_l_b.Xi_outflow[1]));

    annotation(experiment(StopTime=60, Interval=0.12, Tolerance=1e-08),
