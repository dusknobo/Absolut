    Modelica.Fluid.Sources.MassFlowSource_T externalSource(redeclare package Medium=Modelica.Media.Water.WaterIF97_R1pT, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.FixedBoundary externalSink(redeclare package Medium=Modelica.Media.Water.WaterIF97_R1pT, nPorts=1, p=300000, use_T=true, T=300);
    parameter Real initialMass(fixed=false);
    parameter Real initialEnergy(fixed=false);
    Real integratedMass(start=0,fixed=true);
    Real integratedEnergy(start=0,fixed=true);
    Real r_mass=dut.m-initialMass-integratedMass;
    Real r_energy=dut.U-initialEnergy-integratedEnergy;
    Real volumeFraction=dut.V_l/dut.V;

  initial equation
    dut.T=dut.T_start; dut.V_l=dut.V_l_start;
    initialMass=dut.m; initialEnergy=dut.U;

  equation
    flow0.m_flow_in=(0.0002)*(if time<30 then 1 else 0.5); flow0.T_in=dut.T_start+5;
    connect(flow0.ports[1], dut.port_v);
    flow1.m_flow_in=(-0.0002)*(if time<30 then 1 else 0.5); flow1.T_in=dut.T_start-2;
    connect(flow1.ports[1], dut.port_l);
    externalSource.m_flow_in=0.2; externalSource.T_in=dut.T_start-(if time<30 then 5 else 3);
    connect(externalSource.ports[1], dut.port_a_ext);
    connect(dut.port_b_ext, externalSink.ports[1]);
    der(integratedMass)=dut.port_v.m_flow + dut.port_l.m_flow;
    der(integratedEnergy)=dut.port_v.m_flow*actualStream(dut.port_v.h_outflow) + dut.port_l.m_flow*actualStream(dut.port_l.h_outflow)+(dut.port_a_ext.m_flow*actualStream(dut.port_a_ext.h_outflow) + dut.port_b_ext.m_flow*actualStream(dut.port_b_ext.h_outflow));

    annotation(experiment(StopTime=60, Interval=0.12, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end CondenserDyn_internalHEXThroughFlow;

