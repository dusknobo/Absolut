  model SingleEffect_intern_AbsorberStatic
    "Standalone steady vessel with physical fluid boundaries and a load/temperature step"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Static.SingleEffect_intern.AbsorberStatic dut(redeclare package Medium_l=Absolut.Media.LiBrH2O,redeclare package Medium_v=Modelica.Media.Water.WaterIF97_R2pT,p_start=2000,X_LiBr_start=0.6,use_p_in=false,use_X_LiBr_in=false);
    Modelica.Fluid.Sources.FixedBoundary outlet(redeclare package Medium=Absolut.Media.LiBrH2O, nPorts=1, p=2000, use_T=true, T=300,X={0.4,0.6});
    Modelica.Fluid.Sources.MassFlowSource_T inlet(redeclare package Medium=Absolut.Media.LiBrH2O, nPorts=1, use_m_flow_in=true, use_T_in=true,X={0.4,0.6});
    Modelica.Fluid.Sources.MassFlowSource_T steam(redeclare package Medium=Modelica.Media.Water.WaterIF97_R2pT, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.MassFlowSource_T unused3(redeclare package Medium=Modelica.Media.Water.WaterIF97_R2pT, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Real r_mass=dut.port_v.m_flow + dut.port_l_b.m_flow + dut.port_l_a.m_flow + dut.port_v_a.m_flow;
    Real r_salt=dut.port_l_b.m_flow*(1-actualStream(dut.port_l_b.Xi_outflow[1])) + dut.port_l_a.m_flow*(1-actualStream(dut.port_l_a.Xi_outflow[1]));
    Real r_duty=dut.port_v.m_flow*actualStream(dut.port_v.h_outflow) + dut.port_l_b.m_flow*actualStream(dut.port_l_b.h_outflow) + dut.port_l_a.m_flow*actualStream(dut.port_l_a.h_outflow) + dut.port_v_a.m_flow*actualStream(dut.port_v_a.h_outflow)-dut.Hb_flow;


  equation
    connect(dut.port_l_b, outlet.ports[1]);
    inlet.m_flow_in=(if time<5 then 0.005 else 0.004); inlet.T_in=330;
    connect(inlet.ports[1], dut.port_l_a);
    steam.m_flow_in=0.0004; steam.T_in=400;
    connect(steam.ports[1], dut.port_v);
    unused3.m_flow_in=0; unused3.T_in=350;
    connect(unused3.ports[1], dut.port_v_a);

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end SingleEffect_intern_AbsorberStatic;

