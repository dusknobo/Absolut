within ;
package ComponentTests "Standalone component tests; generated by tests/generate_components.py"
  model EnthalpyBoundary "Only the entering stream state is prescribed; p and m_flow are free"
    replaceable package Medium=Modelica.Media.Water.WaterIF97_R1pT;
    parameter Modelica.Units.SI.Temperature T=300;
    parameter Medium.MassFraction X[Medium.nX]=Medium.X_default;
    Modelica.Fluid.Interfaces.FluidPort_b port(redeclare package Medium=Medium);
  equation
    port.h_outflow=Medium.specificEnthalpy(Medium.setState_pTX(port.p,T,X));
    port.Xi_outflow=X[1:Medium.nXi];
    port.C_outflow=zeros(Medium.nC);
  end EnthalpyBoundary;
  model EER_HalfEffectAHP
    "Three analytic operating points and temperature steps"
    Integer point = if time<3 then 1 elseif time<6 then 2 else 3;
    Absolut.Basic.Blocks.EER_HalfEffectAHP dut;
    parameter Real expected[3]={0.8,0.75,0.6};
    Real r_eer=dut.EER-0.5*expected[point];


  equation
    dut.Te=if point==1 then 280 elseif point==2 then 285 else 300;
    dut.Th=if point==1 then 350 elseif point==2 then 380 else 500;

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end EER_HalfEffectAHP;

  model EER_SingleEffectAHP
    "Three analytic operating points and temperature steps"
    Integer point = if time<3 then 1 elseif time<6 then 2 else 3;
    Absolut.Basic.Blocks.EER_SingleEffectAHP dut;
    parameter Real expected[3]={0.8,0.75,0.6};
    Real r_eer=dut.EER-1*expected[point];
    Real r_cop=dut.COP-dut.EER-1;


  equation
    dut.Te=if point==1 then 280 elseif point==2 then 285 else 300;
    dut.Th=if point==1 then 350 elseif point==2 then 380 else 500;

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end EER_SingleEffectAHP;

  model EER_DoubleEffectAHP
    "Three analytic operating points and temperature steps"
    Integer point = if time<3 then 1 elseif time<6 then 2 else 3;
    Absolut.Basic.Blocks.EER_DoubleEffectAHP dut;
    parameter Real expected[3]={0.8,0.75,0.6};
    Real r_eer=dut.EER-2*expected[point];


  equation
    dut.Te=if point==1 then 280 elseif point==2 then 285 else 300;
    dut.Th=if point==1 then 350 elseif point==2 then 380 else 500;

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end EER_DoubleEffectAHP;

  model EER_TripleEffectAHP
    "Three analytic operating points and temperature steps"
    Integer point = if time<3 then 1 elseif time<6 then 2 else 3;
    Absolut.Basic.Blocks.EER_TripleEffectAHP dut;
    parameter Real expected[3]={0.8,0.75,0.6};
    Real r_eer=dut.EER-3*expected[point];


  equation
    dut.Te=if point==1 then 280 elseif point==2 then 285 else 300;
    dut.Th=if point==1 then 350 elseif point==2 then 380 else 500;

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end EER_TripleEffectAHP;

  model CarnotSingleEffectAHP
    "Reversible-cycle entropy balance and heating/cooling COP identity"
    Integer point = if time<3 then 1 elseif time<6 then 2 else 3;
    Absolut.Basic.Blocks.CarnotSingleEffectAHP dut;
    Real r_entropy=dut.EER/dut.Tei+1/dut.Thi-dut.COP/dut.Tci;
    Real r_cop=dut.COP-dut.EER-1;
    Real r_energy=dut.Qh+dut.Qe-dut.Qc;


  equation
    dut.Tei=280+point; dut.Thi=360+10*point; dut.Tci=310+5*point;
    dut.Qh=1000*point;

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end CarnotSingleEffectAHP;

  model EER_CarnotSingleEffectAHP
    "Reversible-cycle entropy balance and heating/cooling COP identity"
    Integer point = if time<3 then 1 elseif time<6 then 2 else 3;
    Absolut.Basic.Blocks.EER_CarnotSingleEffectAHP dut;
    Real r_entropy=dut.EER/dut.Te+1/dut.Th-dut.COP/dut.Tc;
    Real r_cop=dut.COP-dut.EER-1;


  equation
    dut.Te=280+point; dut.Th=360+10*point; dut.Tc=310+5*point;

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end EER_CarnotSingleEffectAHP;

  model DDT_AHT
    "Three independent Duehring temperature-difference values"
    Integer point = if time<3 then 1 elseif time<6 then 2 else 3;
    Absolut.Basic.Blocks.DDT_AHT dut;
    parameter Real expected[3]={10.5,12.0,25.0};
    Real r_ddt=dut.DDT-expected[point];

  equation
    dut.Te=if point==1 then 350 elseif point==2 then 360 else 350;
    dut.Tc=300; dut.Tg=350; dut.Ta=if point==1 then 397 elseif point==2 then 407 else 382.5;
    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end DDT_AHT;

  model Tfiring
    "Minimum firing temperature at three independent analytic reference points"
    Integer point = if time<3 then 1 elseif time<6 then 2 else 3;
    Absolut.Basic.Blocks.Tfiring dut;
    parameter Real expected[3]={360,390,325};
    Real r_temperature=dut.Th-expected[point];

  equation
    dut.Te=if point==1 then 280 elseif point==2 then 290 else 285;
    dut.Tc=if point==1 then 310 elseif point==2 then 320 else 305;
    dut.dT=if point==1 then 5 elseif point==2 then 10 else 0;
    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end Tfiring;

  model ZeroOrderSingleEffectAHP
    "Equal internal temperature lifts and analytic COP values"
    Integer point = if time<3 then 1 elseif time<6 then 2 else 3;
    Absolut.Basic.Blocks.ZeroOrderSingleEffectAHP dut;
    parameter Real expected[3]={0.8,0.75,0.75};
    Real r_eer=dut.EER-expected[point];
    Real r_energy=dut.Qh+dut.Qe-dut.Qc;
    Real r_cop=dut.COP-dut.EER-1;

  equation
    dut.Thi=if point==1 then 350 elseif point==2 then 380 else 400;
    dut.Tci=if point==1 then 315 elseif point==2 then 332.5 else 350;
    dut.Qh=1000*point;
    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end ZeroOrderSingleEffectAHP;

  model ZeroOrderSingleEffectAHP_ext
    "External UA network and three closed-form reference solutions"
    Integer point = if time<3 then 1 elseif time<6 then 2 else 3;
    Absolut.Basic.Blocks.ZeroOrderSingleEffectAHP_ext dut;
    parameter Real expected[3]={0.8181818181818182,0.7714285714285715,0.7837837837837838};
    Real r_eer=dut.EER-expected[point];
    Real r_energy=dut.Qh+dut.Qe-dut.Qc;
    Real r_cop=dut.COP-dut.EER-1;

  equation
    dut.Th=if point==1 then 360 elseif point==2 then 380 else 400;
    dut.Tc=if point==1 then 300 elseif point==2 then 310 else 330;
    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end ZeroOrderSingleEffectAHP_ext;

  model Pump
    "Nominal flow, part load and zero flow; port enthalpy, work and outlet thermometer"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Static.Components.Pump dut(redeclare package Medium_l=Absolut.Media.LiBrH2O, T_in_start=300);
    Modelica.Fluid.Sources.FixedBoundary source(redeclare package Medium=Absolut.Media.LiBrH2O, nPorts=1, p=100000, use_T=true, T=300, X={0.4,0.6});
    Modelica.Fluid.Sources.FixedBoundary sink(redeclare package Medium=Absolut.Media.LiBrH2O, nPorts=1, p=500000, use_T=true, T=310, X={0.4,0.6});
    Real r_mass=dut.port_l_a.m_flow + dut.port_l_b.m_flow;
    Real r_energy=dut.port_l_a.m_flow*actualStream(dut.port_l_a.h_outflow) + dut.port_l_b.m_flow*actualStream(dut.port_l_b.h_outflow)+dut.W_p;
    Real r_efficiency=dut.W_p-dut.etha*dut.W_el;
    Real r_inletTemperature=dut.T-300;
    Real r_temperature=dut.T_out-Absolut.Media.LiBrH2O.temperature(Absolut.Media.LiBrH2O.setState_phX(dut.port_l_b.p,dut.port_l_b.h_outflow,inStream(dut.port_l_a.Xi_outflow)));
    Real r_salt=dut.port_l_a.m_flow*(1-actualStream(dut.port_l_a.Xi_outflow[1])) + dut.port_l_b.m_flow*(1-actualStream(dut.port_l_b.Xi_outflow[1]));


  equation
    dut.m_dot_in=if time<3 then 0.05 elseif time<6 then 0.01 else 0;
    connect(dut.port_l_a, source.ports[1]);
    connect(dut.port_l_b, sink.ports[1]);

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end Pump;

  model PumpW
    "Nominal flow, part load and zero flow; port enthalpy, work and outlet thermometer"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Static.Components.PumpW dut(redeclare package Medium_l=Modelica.Media.Water.WaterIF97_R1pT);
    Modelica.Fluid.Sources.FixedBoundary source(redeclare package Medium=Modelica.Media.Water.WaterIF97_R1pT, nPorts=1, p=100000, use_T=true, T=300);
    Modelica.Fluid.Sources.FixedBoundary sink(redeclare package Medium=Modelica.Media.Water.WaterIF97_R1pT, nPorts=1, p=500000, use_T=true, T=310);
    Real r_mass=dut.port_l_a.m_flow + dut.port_l_b.m_flow;
    Real r_energy=dut.port_l_a.m_flow*actualStream(dut.port_l_a.h_outflow) + dut.port_l_b.m_flow*actualStream(dut.port_l_b.h_outflow)+dut.W_p;
    Real r_efficiency=dut.W_p-dut.etha*dut.W_el;
    Real r_inletTemperature=dut.T-300;
    Real r_temperature=dut.T_out-Modelica.Media.Water.WaterIF97_R1pT.temperature(Modelica.Media.Water.WaterIF97_R1pT.setState_phX(dut.port_l_b.p,dut.port_l_b.h_outflow,inStream(dut.port_l_a.Xi_outflow)));


  equation
    dut.m_dot_in=if time<3 then 0.05 elseif time<6 then 0.01 else 0;
    connect(dut.port_l_a, source.ports[1]);
    connect(dut.port_l_b, sink.ports[1]);

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end PumpW;

  model Compressor
    "Adiabatic compressor energy and isentropic efficiency; pressure ratio 2"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Static.Components.Compressor dut(redeclare package Medium_v=Modelica.Media.Water.WaterIF97_R2pT,Pr_set=2);
    Modelica.Fluid.Sources.MassFlowSource_T source(redeclare package Medium=Modelica.Media.Water.WaterIF97_R2pT, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.FixedBoundary sink(redeclare package Medium=Modelica.Media.Water.WaterIF97_R2pT, nPorts=1, p=20000, use_T=true, T=400);
    Real r_mass=dut.port_v_a.m_flow + dut.port_v_b.m_flow;
    Real r_energy=dut.port_v_a.m_flow*actualStream(dut.port_v_a.h_outflow) + dut.port_v_b.m_flow*actualStream(dut.port_v_b.h_outflow)+dut.W;
    Real r_efficiency=dut.eff_is*(dut.port_v_b.h_outflow-inStream(dut.port_v_a.h_outflow))-(dut.h2s-inStream(dut.port_v_a.h_outflow));
    Real r_ratio=dut.port_v_b.p/dut.port_v_a.p-2;

  equation
    source.m_flow_in=if time<5 then 0.001 else 0.0003; source.T_in=350+time;
    connect(source.ports[1], dut.port_v_a);
    connect(dut.port_v_b, sink.ports[1]);

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end Compressor;

  model CompressorUnityRatio
    "Adiabatic compressor energy and isentropic efficiency; pressure ratio 1"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Static.Components.Compressor dut(redeclare package Medium_v=Modelica.Media.Water.WaterIF97_R2pT,Pr_set=1);
    Modelica.Fluid.Sources.MassFlowSource_T source(redeclare package Medium=Modelica.Media.Water.WaterIF97_R2pT, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.FixedBoundary sink(redeclare package Medium=Modelica.Media.Water.WaterIF97_R2pT, nPorts=1, p=20000, use_T=true, T=400);
    Real r_mass=dut.port_v_a.m_flow + dut.port_v_b.m_flow;
    Real r_energy=dut.port_v_a.m_flow*actualStream(dut.port_v_a.h_outflow) + dut.port_v_b.m_flow*actualStream(dut.port_v_b.h_outflow)+dut.W;
    Real r_efficiency=dut.eff_is*(dut.port_v_b.h_outflow-inStream(dut.port_v_a.h_outflow))-(dut.h2s-inStream(dut.port_v_a.h_outflow));
    Real r_ratio=dut.port_v_b.p/dut.port_v_a.p-1;
    Real r_zeroPower=dut.W;
    Real r_zeroEnthalpyRise=dut.port_v_b.h_outflow-inStream(dut.port_v_a.h_outflow);

  equation
    source.m_flow_in=if time<5 then 0.001 else 0.0003; source.T_in=350+time;
    connect(source.ports[1], dut.port_v_a);
    connect(dut.port_v_b, sink.ports[1]);

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end CompressorUnityRatio;

  model FlashingWater
    "Two cooling/heating cycles across flash onset, with valve opening step"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Static.Components.FlashingWater dut(redeclare package Medium_l=Modelica.Media.Water.WaterIF97_R1pT,redeclare package Medium_v=Modelica.Media.Water.WaterIF97_R2pT,m_flow_nominal=0.05,dp_nominal=9000,T_out_start=320);
    Modelica.Fluid.Sources.MassFlowSource_T source(redeclare package Medium=Modelica.Media.Water.WaterIF97_R1pT, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.FixedBoundary liquidSink(redeclare package Medium=Modelica.Media.Water.WaterIF97_R1pT, nPorts=1, p=1000, use_T=true, T=300);
    Modelica.Fluid.Sources.FixedBoundary vaporSink(redeclare package Medium=Modelica.Media.Water.WaterIF97_R2pT, nPorts=1, p=1000, use_T=true, T=320);
    Real r_mass=dut.port_a.m_flow + dut.port_l_b.m_flow + dut.port_v_b.m_flow;
    Real r_energy=dut.port_a.m_flow*actualStream(dut.port_a.h_outflow) + dut.port_l_b.m_flow*actualStream(dut.port_l_b.h_outflow) + dut.port_v_b.m_flow*actualStream(dut.port_v_b.h_outflow);
    Real r_quality=dut.Q* dut.port_a.m_flow+dut.port_v_b.m_flow;
    Real r_hydraulic=dut.port_a.m_flow-dut.opening*0.05/9000*(dut.port_a.p-dut.port_l_b.p);


  equation
    dut.opening=if time<120 then 1 else 0.5;
    source.m_flow_in=0.05; source.T_in=280.15+5*cos(2*Modelica.Constants.pi*time/120);
    connect(source.ports[1], dut.port_a);
    connect(dut.port_l_b, liquidSink.ports[1]);
    connect(dut.port_v_b, vaporSink.ports[1]);

    annotation(experiment(StopTime=240, Interval=0.48, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end FlashingWater;

  model FlashingLiBr
    "Two cooling/heating cycles across flash onset, with valve opening step"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Static.Components.FlashingLiBr dut(redeclare package Medium_l=Absolut.Media.LiBrH2O,redeclare package Medium_v=Modelica.Media.Water.WaterIF97_R2pT,m_flow_nominal=0.05,dp_nominal=9000,T_out_start=320,X_LiBr_start=0.6,p_out_start=1000,T_out_intern_auxiliar(start=320));
    Modelica.Fluid.Sources.MassFlowSource_T source(redeclare package Medium=Absolut.Media.LiBrH2O, nPorts=1, use_m_flow_in=true, use_T_in=true, X={0.4,0.6});
    Modelica.Fluid.Sources.FixedBoundary liquidSink(redeclare package Medium=Absolut.Media.LiBrH2O, nPorts=1, p=1000, use_T=true, T=300, X={0.4,0.6});
    Modelica.Fluid.Sources.FixedBoundary vaporSink(redeclare package Medium=Modelica.Media.Water.WaterIF97_R2pT, nPorts=1, p=1000, use_T=true, T=320);
    Real r_mass=dut.port_a.m_flow + dut.port_l_b.m_flow + dut.port_v_b.m_flow;
    Real r_energy=dut.port_a.m_flow*actualStream(dut.port_a.h_outflow) + dut.port_l_b.m_flow*actualStream(dut.port_l_b.h_outflow) + dut.port_v_b.m_flow*actualStream(dut.port_v_b.h_outflow);
    Real r_quality=dut.Q* dut.port_a.m_flow+dut.port_v_b.m_flow;
    Real r_hydraulic=dut.port_a.m_flow-dut.opening*0.05/9000*(dut.port_a.p-dut.port_l_b.p);
    Real r_salt=dut.port_a.m_flow*(1-actualStream(dut.port_a.Xi_outflow[1])) + dut.port_l_b.m_flow*(1-actualStream(dut.port_l_b.Xi_outflow[1]));


  equation
    dut.opening=if time<120 then 1 else 0.5;
    source.m_flow_in=0.05; source.T_in=323.15+10*cos(2*Modelica.Constants.pi*time/120);
    connect(source.ports[1], dut.port_a);
    connect(dut.port_l_b, liquidSink.ports[1]);
    connect(dut.port_v_b, vaporSink.ports[1]);

    annotation(experiment(StopTime=240, Interval=0.48, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end FlashingLiBr;

  model HEX_ConstantEffectiveness
    "Capacity ratio 0.5; analytic heat duty at nominal, part and zero flow"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Static.Components.HEX.ConstantEffectiveness dut(redeclare package Medium1=Modelica.Media.Water.ConstantPropertyLiquidWater,redeclare package Medium2=Modelica.Media.Water.ConstantPropertyLiquidWater,m1_flow_nominal=1,m2_flow_nominal=2,dp1_nominal=100,dp2_nominal=100,eps=0.7);
    Modelica.Fluid.Sources.MassFlowSource_T hot(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.MassFlowSource_T cold(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.FixedBoundary hotSink(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, p=100000, use_T=true, T=353.15);
    Modelica.Fluid.Sources.FixedBoundary coldSink(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, p=100000, use_T=true, T=293.15);
    Real flowFraction=if time<3 then 1 elseif time<6 then 0.4 else 0;
    parameter Real nominalEps=10000/(4184*60);
    parameter Real nominalNTU=-log((1-nominalEps)/(1-0.5*nominalEps))/0.5;
    Real expectedNTU=if time>=6 then 0 else nominalNTU*flowFraction^(-0.2);
    Real r_mass1=dut.port_a1.m_flow + dut.port_b1.m_flow;
    Real r_mass2=dut.port_a2.m_flow + dut.port_b2.m_flow;
    Real r_energy=dut.port_a1.m_flow*actualStream(dut.port_a1.h_outflow) + dut.port_b1.m_flow*actualStream(dut.port_b1.h_outflow) + dut.port_a2.m_flow*actualStream(dut.port_a2.h_outflow) + dut.port_b2.m_flow*actualStream(dut.port_b2.h_outflow);
    Real heatHot=dut.port_a1.m_flow*actualStream(dut.port_a1.h_outflow) + dut.port_b1.m_flow*actualStream(dut.port_b1.h_outflow);
    Real expectedHeat=if time>=6 then 0 else 0.7*(if time<3 then 1 else 0.4)*4184*60;
    Real r_heat=heatHot-expectedHeat;


  equation
    hot.m_flow_in=if time<3 then 1 elseif time<6 then 0.4 else 0; hot.T_in=353.15;
    connect(hot.ports[1], dut.port_a1);
    cold.m_flow_in=if time<3 then 2 elseif time<6 then 0.8 else 0; cold.T_in=293.15;
    connect(cold.ports[1], dut.port_a2);
    connect(dut.port_b1, hotSink.ports[1]);
    connect(dut.port_b2, coldSink.ports[1]);

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end HEX_ConstantEffectiveness;

  model HEX_PlateHeatExchangerEffectivenessNTU
    "Capacity ratio 0.5; analytic heat duty at nominal, part and zero flow"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Static.Components.HEX.PlateHeatExchangerEffectivenessNTU dut(redeclare package Medium1=Modelica.Media.Water.ConstantPropertyLiquidWater,redeclare package Medium2=Modelica.Media.Water.ConstantPropertyLiquidWater,m1_flow_nominal=1,m2_flow_nominal=2,dp1_nominal=100,dp2_nominal=100,configuration=Buildings.Fluid.Types.HeatExchangerConfiguration.CounterFlow,Q_flow_nominal=10000,T_a1_nominal=353.15,T_a2_nominal=293.15);
    Modelica.Fluid.Sources.MassFlowSource_T hot(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.MassFlowSource_T cold(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.FixedBoundary hotSink(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, p=100000, use_T=true, T=353.15);
    Modelica.Fluid.Sources.FixedBoundary coldSink(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, p=100000, use_T=true, T=293.15);
    Real flowFraction=if time<3 then 1 elseif time<6 then 0.4 else 0;
    parameter Real nominalEps=10000/(4184*60);
    parameter Real nominalNTU=-log((1-nominalEps)/(1-0.5*nominalEps))/0.5;
    Real expectedNTU=if time>=6 then 0 else nominalNTU*flowFraction^(-0.2);
    Real r_mass1=dut.port_a1.m_flow + dut.port_b1.m_flow;
    Real r_mass2=dut.port_a2.m_flow + dut.port_b2.m_flow;
    Real r_energy=dut.port_a1.m_flow*actualStream(dut.port_a1.h_outflow) + dut.port_b1.m_flow*actualStream(dut.port_b1.h_outflow) + dut.port_a2.m_flow*actualStream(dut.port_a2.h_outflow) + dut.port_b2.m_flow*actualStream(dut.port_b2.h_outflow);
    Real heatHot=dut.port_a1.m_flow*actualStream(dut.port_a1.h_outflow) + dut.port_b1.m_flow*actualStream(dut.port_b1.h_outflow);
    Real expectedHeat=if time>=6 then 0 else flowFraction*4184*60*(1-exp(-0.5*expectedNTU))/(1-0.5*exp(-0.5*expectedNTU));
    Real r_heat=heatHot-expectedHeat;


  equation
    hot.m_flow_in=if time<3 then 1 elseif time<6 then 0.4 else 0; hot.T_in=353.15;
    connect(hot.ports[1], dut.port_a1);
    cold.m_flow_in=if time<3 then 2 elseif time<6 then 0.8 else 0; cold.T_in=293.15;
    connect(cold.ports[1], dut.port_a2);
    connect(dut.port_b1, hotSink.ports[1]);
    connect(dut.port_b2, coldSink.ports[1]);

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end HEX_PlateHeatExchangerEffectivenessNTU;

  model HEX_simpleHX
    "Capacity ratio 0.5; analytic heat duty at nominal, part and zero flow"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Static.Components.HEX.simpleHX dut(redeclare package Medium1=Modelica.Media.Water.ConstantPropertyLiquidWater,redeclare package Medium2=Modelica.Media.Water.ConstantPropertyLiquidWater,m1_flow_nominal=1,m2_flow_nominal=2,dp1_nominal=100,dp2_nominal=100,configuration=Buildings.Fluid.Types.HeatExchangerConfiguration.CounterFlow,UA_fix=1000);
    Modelica.Fluid.Sources.MassFlowSource_T hot(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.MassFlowSource_T cold(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.FixedBoundary hotSink(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, p=100000, use_T=true, T=353.15);
    Modelica.Fluid.Sources.FixedBoundary coldSink(redeclare package Medium=Modelica.Media.Water.ConstantPropertyLiquidWater, nPorts=1, p=100000, use_T=true, T=293.15);
    Real flowFraction=if time<3 then 1 elseif time<6 then 0.4 else 0;
    parameter Real nominalEps=10000/(4184*60);
    parameter Real nominalNTU=-log((1-nominalEps)/(1-0.5*nominalEps))/0.5;
    Real expectedNTU=if time>=6 then 0 else 1000/(flowFraction*4184);
    Real r_mass1=dut.port_a1.m_flow + dut.port_b1.m_flow;
    Real r_mass2=dut.port_a2.m_flow + dut.port_b2.m_flow;
    Real r_energy=dut.port_a1.m_flow*actualStream(dut.port_a1.h_outflow) + dut.port_b1.m_flow*actualStream(dut.port_b1.h_outflow) + dut.port_a2.m_flow*actualStream(dut.port_a2.h_outflow) + dut.port_b2.m_flow*actualStream(dut.port_b2.h_outflow);
    Real heatHot=dut.port_a1.m_flow*actualStream(dut.port_a1.h_outflow) + dut.port_b1.m_flow*actualStream(dut.port_b1.h_outflow);
    Real expectedHeat=if time>=6 then 0 else flowFraction*4184*60*(1-exp(-0.5*expectedNTU))/(1-0.5*exp(-0.5*expectedNTU));
    Real r_heat=heatHot-expectedHeat;


  equation
    hot.m_flow_in=if time<3 then 1 elseif time<6 then 0.4 else 0; hot.T_in=353.15;
    connect(hot.ports[1], dut.port_a1);
    cold.m_flow_in=if time<3 then 2 elseif time<6 then 0.8 else 0; cold.T_in=293.15;
    connect(cold.ports[1], dut.port_a2);
    connect(dut.port_b1, hotSink.ports[1]);
    connect(dut.port_b2, coldSink.ports[1]);

    annotation(experiment(StopTime=10, Interval=0.02, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end HEX_simpleHX;

  model AbsorberDyn_heatportClosed
    "Sealed working-fluid volume with thermal excitation; integrated inventory checks"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Dynamic.Components.AbsorberDyn_heatport dut(p_start=2000,UA=50,X_LiBr_start=0.6);
    Modelica.Thermal.HeatTransfer.Sources.PrescribedHeatFlow heat;
    parameter Real initialMass(fixed=false);
    parameter Real initialEnergy(fixed=false);
    Real integratedMass(start=0,fixed=true);
    Real integratedEnergy(start=0,fixed=true);
    Real r_mass=dut.m-initialMass-integratedMass;
    Real r_energy=dut.U-initialEnergy-integratedEnergy;
    Real volumeFraction=dut.V_l/dut.V;
    parameter Real initialSalt(fixed=false);
    Real integratedSalt(start=0,fixed=true);
    Real r_salt=dut.m_l*dut.X_LiBr-initialSalt-integratedSalt;

  initial equation
    dut.T=dut.T_start; dut.V_l=dut.V_l_start;
    dut.X_LiBr=0.6;
    initialMass=dut.m; initialEnergy=dut.U;
    initialSalt=dut.m_l*dut.X_LiBr;

  equation
    heat.Q_flow=if time<20 then 100 elseif time<40 then 0 else -100;
    connect(heat.port,dut.heatPort);
    der(integratedMass)=dut.port_l_a.m_flow + dut.port_l_b.m_flow + dut.port_v.m_flow + dut.port_v_a.m_flow;
    der(integratedEnergy)=dut.port_l_a.m_flow*actualStream(dut.port_l_a.h_outflow) + dut.port_l_b.m_flow*actualStream(dut.port_l_b.h_outflow) + dut.port_v.m_flow*actualStream(dut.port_v.h_outflow) + dut.port_v_a.m_flow*actualStream(dut.port_v_a.h_outflow)+(dut.heatPort.Q_flow);
    der(integratedSalt)=dut.port_l_a.m_flow*(1-actualStream(dut.port_l_a.Xi_outflow[1])) + dut.port_l_b.m_flow*(1-actualStream(dut.port_l_b.Xi_outflow[1]));

    annotation(experiment(StopTime=60, Interval=0.12, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end AbsorberDyn_heatportClosed;

  model AbsorberDyn_heatportThroughFlow
    "Mass/enthalpy through-flow with step; integrated inventory checks"
    inner Modelica.Fluid.System system;
    Absolut.FluidBased.Dynamic.Components.AbsorberDyn_heatport dut(p_start=2000,UA=50,X_LiBr_start=0.6);
    Modelica.Fluid.Sources.MassFlowSource_T flow0(redeclare package Medium=Absolut.Media.LiBrH2O, nPorts=1, use_m_flow_in=true, use_T_in=true,X={0.4,0.6});
    Modelica.Fluid.Sources.MassFlowSource_T flow1(redeclare package Medium=Absolut.Media.LiBrH2O, nPorts=1, use_m_flow_in=true, use_T_in=true,X={0.4,0.6});
    Modelica.Fluid.Sources.MassFlowSource_T flow2(redeclare package Medium=Modelica.Media.Water.WaterIF97_R2pT, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Fluid.Sources.MassFlowSource_T flow3(redeclare package Medium=Modelica.Media.Water.WaterIF97_R2pT, nPorts=1, use_m_flow_in=true, use_T_in=true);
    Modelica.Thermal.HeatTransfer.Sources.PrescribedHeatFlow heat;
    parameter Real initialMass(fixed=false);
    parameter Real initialEnergy(fixed=false);
    Real integratedMass(start=0,fixed=true);
    Real integratedEnergy(start=0,fixed=true);
    Real r_mass=dut.m-initialMass-integratedMass;
    Real r_energy=dut.U-initialEnergy-integratedEnergy;
    Real volumeFraction=dut.V_l/dut.V;
    parameter Real initialSalt(fixed=false);
    Real integratedSalt(start=0,fixed=true);
    Real r_salt=dut.m_l*dut.X_LiBr-initialSalt-integratedSalt;

  initial equation
    dut.T=dut.T_start; dut.V_l=dut.V_l_start;
    dut.X_LiBr=0.6;
    initialMass=dut.m; initialEnergy=dut.U;
    initialSalt=dut.m_l*dut.X_LiBr;

  equation
    flow0.m_flow_in=(0.005)*(if time<30 then 1 else 0.5); flow0.T_in=dut.T_start;
    connect(flow0.ports[1], dut.port_l_a);
    flow1.m_flow_in=(-0.00502)*(if time<30 then 1 else 0.5); flow1.T_in=dut.T_start;
    connect(flow1.ports[1], dut.port_l_b);
    flow2.m_flow_in=(0.00002)*(if time<30 then 1 else 0.5); flow2.T_in=dut.T_start+5;
    connect(flow2.ports[1], dut.port_v);
    flow3.m_flow_in=(0)*(if time<30 then 1 else 0.5); flow3.T_in=dut.T_start+5;
    connect(flow3.ports[1], dut.port_v_a);
    heat.Q_flow=if time<20 then 100 elseif time<40 then 0 else -100;
    connect(heat.port,dut.heatPort);
    der(integratedMass)=dut.port_l_a.m_flow + dut.port_l_b.m_flow + dut.port_v.m_flow + dut.port_v_a.m_flow;
    der(integratedEnergy)=dut.port_l_a.m_flow*actualStream(dut.port_l_a.h_outflow) + dut.port_l_b.m_flow*actualStream(dut.port_l_b.h_outflow) + dut.port_v.m_flow*actualStream(dut.port_v.h_outflow) + dut.port_v_a.m_flow*actualStream(dut.port_v_a.h_outflow)+(dut.heatPort.Q_flow);
    der(integratedSalt)=dut.port_l_a.m_flow*(1-actualStream(dut.port_l_a.Xi_outflow[1])) + dut.port_l_b.m_flow*(1-actualStream(dut.port_l_b.Xi_outflow[1]));

    annotation(experiment(StopTime=60, Interval=0.12, Tolerance=1e-08),
      __OpenModelica_commandLineOptions="--preOptModules-=evalFunc");
  end AbsorberDyn_heatportThroughFlow;

