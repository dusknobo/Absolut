+    annotation(Placement(transformation(extent={{-82,-88},{-62,-68}})));
+  Modelica.Thermal.HeatTransfer.Sources.PrescribedHeatFlow heat2
+    annotation(Placement(transformation(extent={{18,-88},{38,-68}})));
+
